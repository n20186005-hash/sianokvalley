---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTopic } from '../data/topics';
import type { Topic } from '../data/topics';

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;
const { slug, group, title, description, content, related } = topic;
const { kicker, h1, lead, updated, facts, sections, faqs } = content;

// Breadcrumb: Beranda / <judul topik>
const breadcrumb = [
  { name: 'Beranda', url: '/' },
  { name: h1, url: `/${slug}/` },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: new URL(b.url, Astro.site).toString(),
  })),
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: h1,
  description,
  url: new URL(`/${slug}/`, Astro.site).toString(),
  isPartOf: { '@type': 'WebSite', name: 'Panduan Ngarai Sianok', url: new URL('/', Astro.site).toString() },
  breadcrumb: breadcrumbLd,
};

const relatedTopics = related.map((s) => getTopic(s)).filter((t): t is Topic => !!t && t.slug !== slug);
---

<BaseLayout title={title} description={description} jsonLd={[webPageLd, breadcrumbLd, faqLd]}>
  <nav aria-label="Breadcrumb" class="shell pt-6 text-sm text-[#657168]">
    <ol class="flex flex-wrap items-center gap-1">
      {breadcrumb.map((b, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <span aria-hidden="true" class="text-[#9b4b35]">/</span>}
          {i === breadcrumb.length - 1
            ? <span class="font-semibold text-[#21362e]">{b.name}</span>
            : <a class="focus-ring rounded hover:text-[#9b4b35]" href={b.url}>{b.name}</a>}
        </li>
      ))}
    </ol>
  </nav>

  <section class="relative overflow-hidden bg-[#15251f] text-white">
    <div class="shell relative py-14 md:py-20">
      <p class="mb-4 text-xs font-extrabold tracking-[.23em] text-[#f1cdbb]">BUKITTINGGI · SUMATERA BARAT</p>
      <p class="kicker !text-[#e7b9a5]">{kicker}</p>
      <h1 class="display mt-3 text-[clamp(2.4rem,6vw,4.6rem)] font-bold leading-[1.02] tracking-[-.03em]">{h1}</h1>
      <p class="mt-6 max-w-2xl text-base leading-7 text-white/82 md:text-lg">{lead}</p>
      <p class="mt-6 text-xs text-white/55">Terakhir diperbarui: {updated}</p>
    </div>
  </section>

  {facts && facts.length > 0 && (
    <section class="shell -mt-8 md:-mt-10">
      <div class="grid gap-4 rounded-3xl border border-[#21362e]/15 bg-[#fbf7ee] p-6 shadow-sm md:grid-cols-3">
        {facts.map((f) => (
          <div>
            <p class="text-xs font-extrabold uppercase tracking-[.16em] text-[#9b4b35]">{f.label}</p>
            <p class="mt-2 text-sm leading-6 text-[#536057]">{f.value}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <div class="shell space-y-16 py-16 md:py-24">
    {sections.map((s) => (
      <section>
        <h2 class="display text-3xl font-bold tracking-tight md:text-4xl">{s.heading}</h2>
        <div class="mt-5 space-y-5 text-[1.05rem] leading-[1.78] text-[#536057]">
          {s.paragraphs?.map((p) => <p>{p}</p>)}
          {s.bullets && (
            <ul class="ml-5 list-disc space-y-2">
              {s.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
          {s.callout && (
            <p class="rounded-2xl border-l-4 border-[#9b4b35] bg-[#f3e9d5]/70 p-4 text-base !text-[#5a4636]">{s.callout}</p>
          )}
        </div>
      </section>
    ))}

    {faqs.length > 0 && (
      <section>
        <h2 class="display text-3xl font-bold tracking-tight md:text-4xl">Pertanyaan umum</h2>
        <div class="mt-6 divide-y divide-[#21362e]/15 border-y border-[#21362e]/15">
          {faqs.map((f, i) => (
            <details class="group" open={i === 0}>
              <summary class="focus-ring flex cursor-pointer list-none items-center justify-between gap-5 rounded-lg py-5 font-bold">
                <span>{f.q}</span>
                <span class="text-xl text-[#9b4b35] group-open:rotate-45">＋</span>
              </summary>
              <p class="max-w-3xl pb-6 pr-10 text-sm leading-7 text-[#667168]">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {relatedTopics.length > 0 && (
      <section class="rounded-3xl border border-[#21362e]/15 bg-white/45 p-8">
        <p class="kicker">Baca juga</p>
        <h2 class="display mt-2 text-2xl font-bold">Panduan terkait</h2>
        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {relatedTopics.map((t) => (
            <a href={`/${t.slug}/`} class="focus-ring group rounded-2xl border border-[#21362e]/15 bg-[#fbf7ee] p-4 transition hover:border-[#9b4b35]/40">
              <p class="text-xs font-extrabold uppercase tracking-[.14em] text-[#9b4b35]">{t.content.kicker}</p>
              <p class="mt-1 font-bold leading-snug text-[#21362e] group-hover:text-[#9b4b35]">{t.content.h1}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="rounded-3xl bg-[#21362e] p-8 text-[#f3e9d5]">
      <p class="text-xs font-extrabold tracking-[.2em] text-[#e7b9a5]">SUMBER & METODE</p>
      <p class="mt-3 max-w-3xl text-sm leading-7 text-white/75">
        Informasi operasional (jam, tarif, akses) adalah bagian yang paling mudah berubah. Angka yang tercantum merujuk pada pemeriksaan
        19 Oktober 2026 terhadap Google Maps dan Dinas Pariwisata Kota Bukittinggi; bila berbeda, konfirmasikan melalui kanal resmi
        dan kondisi lapangan terbaru. Panduan ini independen dan nirlaba, tanpa hubungan afiliasi dengan instansi pemerintah mana pun.
      </p>
      <a href="https://maps.app.goo.gl/Pb3rVNTMea9Z7Uby5" target="_blank" rel="noreferrer" class="mt-5 inline-flex rounded-full bg-[#f3e9d5] px-5 py-3 text-sm font-bold text-[#21362e]">Buka Google Maps ↗</a>
    </section>
  </div>
</BaseLayout>
