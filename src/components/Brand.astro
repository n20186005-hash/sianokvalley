---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<a href="/" class="focus-ring inline-flex items-center gap-3 rounded-xl" aria-label="Beranda Panduan Ngarai Sianok">
  <svg width={compact ? 44 : 52} height={compact ? 44 : 52} viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="14" fill="#F3E9D5"/>
    <path d="M8 23 20 10l10 12L41 9l13 15" fill="none" stroke="#9B4B35" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M7 34c13-8 20-5 28 4 8 8 15 8 23 2" fill="none" stroke="#315848" stroke-width="7" stroke-linecap="round"/>
    <path d="M9 48c11-6 22-4 31 2 6 4 11 4 16 1" fill="none" stroke="#71806B" stroke-width="5" stroke-linecap="round"/>
  </svg>
  <span class:list={["leading-none", compact && "hidden sm:block"]}>
    <strong class="display block text-lg tracking-wide">SIANOK</strong>
    <span class="mt-1 block text-[9px] font-bold tracking-[.22em] text-[#76594A]">PANDUAN NGARAI</span>
  </span>
</a>
